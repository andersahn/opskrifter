<!doctype html>
<html lang="{{ site.sprog }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if titel %}{{ titel }} – {{ site.navn }}{% else %}{{ site.navn }}{% endif %}</title>
    {% if beskrivelse %}<meta name="description" content="{{ beskrivelse }}">{% endif %}
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header class="sidehoved">
      <a class="mærke" href="/">{{ site.navn }}</a>
      <nav>
        <a href="/">Alle opskrifter</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="sidefod">
      <p>{{ site.navn }} — {{ site.undertitel }}</p>
    </footer>
  </body>
</html>
